<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!--
    Launch file para Navegacion Topologica

    Uso:
        roslaunch navegacion_topologica topological_navigation.launch escenario:=1

    Parametros:
        escenario: 1, 2, 3 o 0 (por defecto: 1)
    -->

    <arg name="escenario" default="1"/>

    <!-- Cargar archivo de configuracion segun el escenario -->
    <param name="/topological_nav/escenario" value="$(arg escenario)"/>

    <!-- Ruta del grafo topologico (relativa al paquete) -->
    <param name="/topological_nav/graph_path"
           value="$(find navegacion_topologica)/mapas/grafos/escenario$(arg escenario)_grafo.json"/>

    <!-- Parametros del planificador A* -->
    <param name="/topological_nav/planning/heuristic" value="euclidean"/>
    <param name="/topological_nav/planning/timeout_seconds" value="30.0"/>

    <!-- Node de navegacion topologica -->
    <node name="topological_navigator"
          pkg="navegacion_topologica"
          type="topological_navigation.py"
          output="screen">
        <param name="graph_json"
               value="$(find navegacion_topologica)/mapas/grafos/escenario$(arg escenario)_grafo.json"/>
    </node>

    <!-- Opcional: Visualizador de grafo -->
    <node name="graph_visualizer"
          pkg="navegacion_topologica"
          type="graph_visualizer.py"
          output="screen"
          required="false">
        <param name="graph_json"
               value="$(find navegacion_topologica)/mapas/grafos/escenario$(arg escenario)_grafo.json"/>
    </node>

</launch>
