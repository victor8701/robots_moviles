<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!--
    Launch file para Navegacion Topologica

    Uso:
        roslaunch navegacion_topologica topological_navigation.launch escenario:=1

    Parametros:
        escenario: 1, 2, 3 o 0 (por defecto: 1)
    -->

    <!-- escenario: 1, 2, 3  |  grafo: nombre del fichero JSON sin ruta
         Para escenarios 1-3:  roslaunch ... escenario:=2
         Para estudio:         roslaunch ... grafo:=estudio_grafo.json -->
    <arg name="escenario" default="1"/>
    <arg name="grafo"     default="escenario$(arg escenario)_grafo.json"/>

    <param name="/topological_nav/escenario" value="$(arg escenario)"/>

    <!-- Node de navegacion topologica -->
    <node name="topological_navigator"
          pkg="navegacion_topologica"
          type="topological_navigation.py"
          output="screen">
        <param name="graph_json"
               value="$(find navegacion_topologica)/mapas/grafos/$(arg grafo)"/>
    </node>

    <!-- Visualizador de grafo en RViz (opcional) -->
    <node name="graph_visualizer"
          pkg="navegacion_topologica"
          type="graph_visualizer.py"
          output="screen"
          required="false">
        <param name="graph_json"
               value="$(find navegacion_topologica)/mapas/grafos/$(arg grafo)"/>
    </node>

</launch>
